# ShellCheck configuration for the whole project.
#
# ShellCheck reads this file from every directory it walks up from a script's
# location, so one file here covers AppleContainer/, Docker/ and Common/.
# A more specific .shellcheckrc in a subdirectory could still override a given
# directive, but none do today.
# enable=add-default-case
enable=avoid-nullary-conditions
enable=check-extra-masked-returns
enable=check-set-e-suppressed
# enable=check-unassigned-uppercase
enable=deprecate-which
enable=quote-safe-variables
# enable=require-double-brackets
enable=require-variable-braces

disable=SC1090 # Can't follow non-constant source. Use a directive to specify location
disable=SC1091 # Not following

# Tests: `[[ cond ]] && ok || bad` only increments counters, never fails, so
# the idiom is safe even when cond is false.
disable=SC2015

# Resolve sourced helpers relative to each script's own directory.
source-path=SCRIPTDIR
